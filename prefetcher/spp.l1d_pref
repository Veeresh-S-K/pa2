#include "cache.h"

//Can have accuracy throtelling per tracker 
//accuracy throtelling can be more linear instead of just min or max
//can change when to fetch to L2 and to L1 - in lesser accuracy, we can fetch to L2 

// --- Configuration Constants ---
#define IP_TRACKER_COUNT       24    
#define PREFETCH_DEGREE_MAX    4     
#define PREFETCH_DEGREE_MIN    1     
#define CS_CONF_THRESH         2     // Minimum confidence for Constant Stride mode
#define CS_CONF_MAX            3     // Maximum value for confidence counter
#define DELTA_HISTORY_LEN      8     // Number of past strides to store per IP
#define ACCURACY_DECAY_THRESH  1024  // Decaying the accuracy counters f
#define MIN_ISSUES_FOR_ACC     16    // Issues before calculating acc
#define RECENT_PF_BUF_SIZE     256   
#define MASK_IP                0xFF  

// --- IP Classification States ---
#define CLASS_NONE 0 // IP has no recognized pattern yet
#define CLASS_CS   1 // IP exhibits a constant stride pattern
#define CLASS_CPLX 2 // IP exhibits a complex (repeating but non-uniform) pattern

// --- Global Accuracy Tracking Variables ---
uint64_t spp_total_issued = 0;                  // Total number of prefetches generated
uint64_t spp_useful_hits  = 0;                  // Number of prefetches that were actually demanded later
uint64_t spp_recent_pf_buf[RECENT_PF_BUF_SIZE]; // Ring buffer storing addresses of recently issued prefetches
int      spp_recent_pf_head = 0;                // Current insertion index for the ring buffer

class IP_TRACKER {
  public:
    uint64_t  ip;           // The instruction pointer currently occupying this tracker
    uint64_t  last_cl_addr; // The cache line address accessed during the previous demand
    int64_t   last_stride;  // The mathematical difference (delta) between the last two accesses
    uint32_t  lru;          // Least Recently Used counter (0 = newest, IP_TRACKER_COUNT-1 = oldest)

    uint8_t   ip_class;      // Current pattern classification (CLASS_NONE, CLASS_CS, or CLASS_CPLX)
    uint8_t   cs_confidence; 

    int64_t   delta_history[DELTA_HISTORY_LEN]; // Circular buffer storing the last N strides observed
    uint8_t   delta_count;                      // Number of valid strides currently in the delta_history buffer
    uint8_t   delta_head;                       // Insertion index for the circular buffer

    IP_TRACKER () {
        ip = 0;
        last_cl_addr = 0;
        last_stride = 0;
        lru = 0;
        ip_class = CLASS_NONE;
        cs_confidence = 0;
        delta_count = 0;
        delta_head = 0;
        for (int i = 0; i < DELTA_HISTORY_LEN; i++) delta_history[i] = 0;
    };

    // when a new IP replaces an old one
    void reset_tracker(uint64_t new_ip, uint64_t cl_addr) {
        ip = new_ip;
        last_cl_addr = cl_addr;
        last_stride = 0;
        ip_class = CLASS_NONE;
        cs_confidence = 0;
        delta_count = 0;
        delta_head = 0;
        for (int i = 0; i < DELTA_HISTORY_LEN; i++) delta_history[i] = 0;
    }

    // inserts the newest stride into circular buffer
    void record_delta(int64_t delta) {
        delta_history[delta_head] = delta;
        delta_head = (delta_head + 1) % DELTA_HISTORY_LEN;
        if (delta_count < DELTA_HISTORY_LEN) delta_count++;
    }

    // searches the recorded delta history for the shortest repeating sequence of strides.
    int find_cycle(int &cycle_start_idx) {
        int n = delta_count;
        if (n < 2) return 0;
        for (int len = 1; len <= n / 2; len++) {
            bool match = true;
            for (int j = 0; j < len; j++) {
                int idx1 = (delta_head - 1 - j + DELTA_HISTORY_LEN) % DELTA_HISTORY_LEN;
                int idx2 = (delta_head - 1 - len - j + DELTA_HISTORY_LEN) % DELTA_HISTORY_LEN;
                if (delta_history[idx1] != delta_history[idx2]) {
                    match = false;
                    break;
                }
            }
            if (match) {
                cycle_start_idx = (delta_head - len + DELTA_HISTORY_LEN) % DELTA_HISTORY_LEN;
                return len;
            }
        }
        return 0;
    }
};

IP_TRACKER trackers[IP_TRACKER_COUNT];

void CACHE::l1d_prefetcher_initialize() {
    for (int i = 0; i < IP_TRACKER_COUNT; i++) trackers[i].lru = i;
    for (int i = 0; i < RECENT_PF_BUF_SIZE; i++) spp_recent_pf_buf[i] = 0;
}

void CACHE::l1d_prefetcher_operate(uint64_t addr, uint64_t ip, uint8_t cache_hit, uint8_t type, uint8_t critical_ip_flag) {
    uint64_t cl_addr = addr >> LOG2_BLOCK_SIZE;

    for (int i = 0; i < RECENT_PF_BUF_SIZE; i++) {
        if (spp_recent_pf_buf[i] == cl_addr) {
            spp_useful_hits++;
            spp_recent_pf_buf[i] = 0;
            break;
        }
    }

    ip = ip & MASK_IP;

    int index = -1;
    for (index = 0; index < IP_TRACKER_COUNT; index++) {
        if (trackers[index].ip == ip)
            break;
    }

    if (index == IP_TRACKER_COUNT) {
        for (index = 0; index < IP_TRACKER_COUNT; index++) {
            if (trackers[index].lru == (IP_TRACKER_COUNT - 1))
                break;
        }

        trackers[index].reset_tracker(ip, cl_addr);
        
        for (int i = 0; i < IP_TRACKER_COUNT; i++) {
            if (trackers[i].lru < trackers[index].lru) trackers[i].lru++;
        }
        trackers[index].lru = 0;
        return;
    }

    // sanity check
    if (index == -1)
        assert(0);

    int64_t stride = 0;
    if (cl_addr > trackers[index].last_cl_addr)
        stride = cl_addr - trackers[index].last_cl_addr;
    else {
        stride = trackers[index].last_cl_addr - cl_addr;
        stride *= -1;
    }
    
    if (stride == 0) return;

    trackers[index].record_delta(stride);

    if (stride == trackers[index].last_stride) {
        if (trackers[index].cs_confidence < CS_CONF_MAX) trackers[index].cs_confidence++;
    } else {
        if (trackers[index].cs_confidence > 0) trackers[index].cs_confidence--;
    }

    if (trackers[index].cs_confidence >= CS_CONF_THRESH) {
        trackers[index].ip_class = CLASS_CS;
    } else if (trackers[index].delta_count >= 4) {
        trackers[index].ip_class = CLASS_CPLX;
    } else {
        trackers[index].ip_class = CLASS_NONE;
    }

    // Dynamic linear throttling
    int current_degree = PREFETCH_DEGREE_MIN;
    if (spp_total_issued > MIN_ISSUES_FOR_ACC) {
        uint64_t accuracy = (spp_useful_hits * 100) / spp_total_issued;
        current_degree = PREFETCH_DEGREE_MIN + ((accuracy * (PREFETCH_DEGREE_MAX - PREFETCH_DEGREE_MIN)) / 100);
        
        // Bounds checking just in case
        if (current_degree > PREFETCH_DEGREE_MAX) current_degree = PREFETCH_DEGREE_MAX;
        if (current_degree < PREFETCH_DEGREE_MIN) current_degree = PREFETCH_DEGREE_MIN;
    }

    if (spp_total_issued > ACCURACY_DECAY_THRESH) {
        spp_total_issued >>= 1;
        spp_useful_hits  >>= 1;
    }

    if (trackers[index].ip_class == CLASS_CS) {
        for (int i = 0; i < current_degree; i++) {
            uint64_t pf_address = (cl_addr + (stride * (i + 1))) << LOG2_BLOCK_SIZE;

            if ((pf_address >> LOG2_PAGE_SIZE) != (addr >> LOG2_PAGE_SIZE)) break;

            int fill_level = (MSHR.occupancy < (MSHR.SIZE >> 1)) ? FILL_L1 : FILL_L2;
            prefetch_line(ip, addr, pf_address, fill_level, 0);

            spp_total_issued++;
            spp_recent_pf_buf[spp_recent_pf_head] = pf_address >> LOG2_BLOCK_SIZE;
            spp_recent_pf_head = (spp_recent_pf_head + 1) % RECENT_PF_BUF_SIZE;
        }

    } else if (trackers[index].ip_class == CLASS_CPLX) {
        int cycle_start_idx = 0;
        int cycle_len = trackers[index].find_cycle(cycle_start_idx);

        if (cycle_len > 0) {
            uint64_t pf_cl = cl_addr;
            
            for (int i = 0; i < current_degree; i++) {
                int64_t step = trackers[index].delta_history[(cycle_start_idx + (i % cycle_len)) % DELTA_HISTORY_LEN];
                pf_cl += step; 
                uint64_t pf_address = pf_cl << LOG2_BLOCK_SIZE;

                if ((pf_address >> LOG2_PAGE_SIZE) != (addr >> LOG2_PAGE_SIZE)) break;

                int fill_level = (MSHR.occupancy < (MSHR.SIZE >> 1)) ? FILL_L1 : FILL_L2;
                prefetch_line(ip, addr, pf_address, fill_level, 0);

                spp_total_issued++;
                spp_recent_pf_buf[spp_recent_pf_head] = pf_address >> LOG2_BLOCK_SIZE;
                spp_recent_pf_head = (spp_recent_pf_head + 1) % RECENT_PF_BUF_SIZE;
            }
        }
    }

    trackers[index].last_cl_addr = cl_addr;
    trackers[index].last_stride  = stride;

    for (int i = 0; i < IP_TRACKER_COUNT; i++) {
        if (trackers[i].lru < trackers[index].lru) trackers[i].lru++;
    }
    trackers[index].lru = 0;
}

void CACHE::l1d_prefetcher_cache_fill(uint64_t v_addr, uint64_t addr, uint32_t set, uint32_t way, uint8_t prefetch, uint64_t v_evicted_addr, uint64_t evicted_addr, uint32_t metadata_in) {}

void CACHE::l1d_prefetcher_final_stats() {}
